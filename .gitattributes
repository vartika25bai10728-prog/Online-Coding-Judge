# Enforce Java as the primary and only major language for GitHub Linguist
* linguist-detectable=false
*.java linguist-detectable=true
backend/** linguist-detectable=true

# Mark web assets, generated files, and node artifacts as vendored/ignored
*.ts linguist-detectable=false
*.tsx linguist-detectable=false
*.js linguist-detectable=false
*.jsx linguist-detectable=false
*.json linguist-detectable=false
*.html linguist-detectable=false
*.css linguist-detectable=false
*.yml linguist-detectable=false
*.xml linguist-detectable=false
*.md linguist-detectable=false
node_modules/** linguist-vendored
dist/** linguist-vendored
src/** linguist-detectable=false
